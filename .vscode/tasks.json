{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: API",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python -m uvicorn main:app --reload",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "presentation": { "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Vite",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Run app",
      "dependsOn": ["Backend: API", "Frontend: Vite"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
