# The backend reads these from the environment. It does NOT load this file
# automatically. Example: export FRONTEND_ORIGINS="https://your-site.example"
# before starting uvicorn, or set them in your hosting provider's dashboard.

# Comma-separated list of frontend URLs allowed to call the API
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite file location (local demo only; use managed PostgreSQL in production)
DB_PATH=cpi.sqlite3
